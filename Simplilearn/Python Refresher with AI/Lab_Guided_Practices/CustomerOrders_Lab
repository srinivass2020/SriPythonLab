#1. Store customer orders

# Step 1 Create a list of customer names
customerNames = ["Alice", "Bob", "Charlie", "Diana"]

# Step 2: Store each customer's order details (customer name, product, price, category) as tuples inside a list
custAliceDetails = ("Alice","Laptop",100.0,"Electronics")
custBobDetails = ("Bob","JavaBook",70.0,"Books")
custCharlieDetails = ("Charlie","Shirt",45.0,"Clothing")
custDiana1Details = ("Diana","Chair",40.0,"Home")
custDiana2Details = ("Diana","Sofa",120,"Home")

allCustomerOrderDetails = [custAliceDetails, custBobDetails, custCharlieDetails, custDiana1Details, custDiana2Details
                           ,("Alice","Shirt",45,"Clothing"),("Elina","Headphones",30,"Electronics"),("Frank","Novel",25,"Books")
                           ,("Bob","Smartphone",200,"Electronics"),("Charlie","Jeans",60,"Clothing"),("Alice","Table",50,"Home")]

print("All Customer Order Details : ", allCustomerOrderDetails)

# Step 3: Use a dictionary where keys are customer names and values are lists of ordered Products
customerOrdersDict = {}
for customerOrder in allCustomerOrderDetails:
    name, product, price, category = customerOrder
    customerOrdersDict[name]= customerOrdersDict.get(name, []) + [product]

print("Customer Orders Dictionary: ", customerOrdersDict)

#2. Classify products by category

# Step 1:  Use a dictionary to map each product to its respective category
productCategoryDict = {}
for productCategory in allCustomerOrderDetails:
    name, product, price, category = productCategory
    if category in productCategoryDict:
        productCategoryDict[category].append(product)
    else:
        productCategoryDict[category] = [product]

# Step 2: Create a set of unique product categories
uniqueCategories = set()
for category, products in productCategoryDict.items():
    uniqueCategories.add(category)

# Step 3: Display all available product categories
print("uniqueCategoriesSet  : ",uniqueCategories)

