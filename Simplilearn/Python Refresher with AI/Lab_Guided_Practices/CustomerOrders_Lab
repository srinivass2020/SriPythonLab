# Step 4: Identify the top three highest-spending customers using sorting
customer_spending = {}
for customer in customerNames:
    total = get_customer_order_total(customer)
    customer_spending[customer] = total
"""
sorted(..., key=lambda x: x[1], reverse=True) sorts that sequence of (name, total) pairs.
key=lambda x: x[1] tells sorted to compare items by the second element of each pair (the spending total).
"""
sorted_customers = sorted(customer_spending.items(), key=lambda x: x[1], reverse=True)
top_three_customers = sorted_customers[:3]
print("Top three highest-spending customers : ", top_three_customers)  

#5. Organize and display data
#Step 1: Print a summary of each customer’s total spending and their classification
def get_customer_category_totals(customer_name):
    customercategoryTotal = {}
    for customerDetailOrder in allCustomerOrderDetails:
        name, _, price, category = customerDetailOrder
        if name == customer_name:
            if category not in customercategoryTotal:
                customercategoryTotal[category] = price
            else:
                customercategoryTotal[category] += price
    return  customercategoryTotal
    
for customer in customerNames:
    orderTotal = get_customer_order_total(customer)
    categoryTotal = get_customer_category_totals(customer)
    print(f"Customer: {customer} spent a total of ${orderTotal} and on each {category} category total is ${categoryTotal}")

